#pragma once

#include <cstdint>
#include <string_view>

namespace asn1pp {

/// Semantic versioning for the asn1pp library.
///
/// Provides compile-time access to MAJOR.MINOR.PATCH and runtime
/// compatibility checking. Generated by CMake configure_file() from
/// the project() version in the root CMakeLists.txt.
struct version {
    static constexpr uint32_t major = @ASN1PP_VERSION_MAJOR@;
    static constexpr uint32_t minor = @ASN1PP_VERSION_MINOR@;
    static constexpr uint32_t patch = @ASN1PP_VERSION_PATCH@;
    static constexpr std::string_view string = "@ASN1PP_VERSION@";
    static constexpr std::string_view sha = "@ASN1PP_GIT_SHA@";
    static constexpr std::string_view dirty = "@ASN1PP_GIT_DIRTY@";

    /// Check that the compiled library is at least the given version.
    /// Returns true if (major, minor, patch) >= requested.
    static constexpr bool at_least(uint32_t req_major, uint32_t req_minor, uint32_t req_patch) noexcept {
        if (major > req_major) return true;
        if (major < req_major) return false;
        if (minor > req_minor) return true;
        if (minor < req_minor) return false;
        return patch >= req_patch;
    }

    /// Check exact version match.
    static constexpr bool is_exactly(uint32_t maj, uint32_t min, uint32_t pat) noexcept {
        return major == maj && minor == min && patch == pat;
    }
};

}  // namespace asn1pp
